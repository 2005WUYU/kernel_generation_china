[Unit]
Description=Ascend Kernel Lab NPU Worker
After=local-fs.target
ConditionPathExists=/opt/ascend-kernel-lab/scripts/run-worker.sh
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ascend-kernel-worker
Group=ascend-kernel
WorkingDirectory=/opt/ascend-kernel-lab
EnvironmentFile=/etc/ascend-kernel-lab/worker.env
EnvironmentFile=-/etc/ascend-kernel-lab/hidden.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ascend-kernel-lab/scripts/run-worker.sh
Restart=on-failure
RestartPreventExitStatus=2 3 10
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
UMask=0007

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
ReadWritePaths=/opt/ascend-kernel-lab/runs
TasksMax=1024
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
