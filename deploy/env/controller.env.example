# Copy to /etc/ascend-kernel-lab/controller.env, fill real values, and chmod 0600.
# This file belongs only to the controller service. Never load it in the Worker.

AKG_PROJECT_ROOT=/opt/ascend-kernel-lab
AKG_VENV_DIR=/opt/ascend-kernel-lab-venv
AKG_CONFIG_PATH=/opt/ascend-kernel-lab/configs/experiment_910c_kimi_k3.yaml

# AIPing Anthropic-compatible endpoint used by Claude CLI.
ANTHROPIC_BASE_URL=https://your-aiping-endpoint.example
ANTHROPIC_AUTH_TOKEN=replace-with-real-token
ANTHROPIC_MODEL=Kimi-K3

# AKG_HIDDEN_SEED is loaded from the separate hidden.env file.
