# Copy to /etc/ascend-kernel-lab/worker.env and adjust paths.
# Never add model tokens, provider endpoints, or Claude configuration.
# AKG_HIDDEN_SEED is loaded from the separate hidden.env file.

AKG_PROJECT_ROOT=/opt/ascend-kernel-lab
AKG_VENV_DIR=/opt/ascend-kernel-lab-venv
AKG_CONFIG_PATH=/opt/ascend-kernel-lab/configs/experiment_910c_kimi_k3.yaml
AKG_CANN_ENV_FILE=/usr/local/Ascend/ascend-toolkit/set_env.sh

DEVICE_ID=0
ASCEND_RT_VISIBLE_DEVICES=0
