ARG CONTROLLER_BASE
ARG CONTROLLER_NODE_BASE

FROM ${CONTROLLER_NODE_BASE} AS node_runtime
FROM ${CONTROLLER_BASE}

ARG CLAUDE_CODE_VERSION
ARG CLAUDE_CODE_INTEGRITY

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Node/npm come from a separately pinned, arm64 Node 22 runtime image. The
# approved Controller base supplies Python, PyYAML and Git.
COPY --from=node_runtime /usr/local /usr/local

RUN test -n "${CLAUDE_CODE_VERSION}" \
    && test -n "${CLAUDE_CODE_INTEGRITY}" \
    && python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
    && python3 -c 'import yaml' \
    && node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' \
    && test "$(npm view "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" dist.integrity)" = "${CLAUDE_CODE_INTEGRITY}" \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && test "$(node -p 'require("/usr/local/lib/node_modules/@anthropic-ai/claude-code/package.json").version')" = "${CLAUDE_CODE_VERSION}" \
    && claude --version | grep -F -- "${CLAUDE_CODE_VERSION}" >/dev/null \
    && command -v git >/dev/null

COPY controller-entrypoint.sh /usr/local/bin/akg-controller-entrypoint
RUN chmod 0555 /usr/local/bin/akg-controller-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/akg-controller-entrypoint"]
CMD []
