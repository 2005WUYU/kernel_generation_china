ARG CONTROLLER_BASE
FROM ${CONTROLLER_BASE}

ARG CLAUDE_CODE_VERSION
ARG CLAUDE_CODE_SHA256
ARG CLAUDE_CODE_ARCHIVE_NAME

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# The official Linux arm64 Claude Code release archive is downloaded and
# hash-verified by the host before the build. No package registry or network is
# used here.
COPY ${CLAUDE_CODE_ARCHIVE_NAME} /tmp/claude-code.tar.gz

RUN test -n "${CLAUDE_CODE_VERSION}" \
    && test -n "${CLAUDE_CODE_SHA256}" \
    && python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
    && python3 -c 'import yaml' \
    && echo "${CLAUDE_CODE_SHA256}  /tmp/claude-code.tar.gz" | sha256sum --check --status \
    && test "$(tar -tzf /tmp/claude-code.tar.gz)" = claude \
    && test "$(tar -tvzf /tmp/claude-code.tar.gz | cut -c1)" = - \
    && mkdir -p /tmp/claude-code-unpack \
    && tar -xzf /tmp/claude-code.tar.gz -C /tmp/claude-code-unpack -- claude \
    && test -f /tmp/claude-code-unpack/claude \
    && test ! -L /tmp/claude-code-unpack/claude \
    && install -m 0555 /tmp/claude-code-unpack/claude /usr/local/bin/claude \
    && claude --version | grep -F -- "${CLAUDE_CODE_VERSION}" >/dev/null \
    && command -v git >/dev/null \
    && rm -rf /tmp/claude-code.tar.gz /tmp/claude-code-unpack

COPY controller-entrypoint.sh /usr/local/bin/akg-controller-entrypoint
RUN chmod 0555 /usr/local/bin/akg-controller-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/akg-controller-entrypoint"]
CMD []
